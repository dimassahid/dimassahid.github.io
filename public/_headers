# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' mailto:

# Hashed build assets never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images and icons.
/images/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon-512.png
  Cache-Control: public, max-age=604800

/favicon-192.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# Machine-readable endpoints.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/*/search-index.json
  Content-Type: application/json; charset=utf-8
