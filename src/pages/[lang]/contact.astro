---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, site, type Lang } from "../../data/site";
import { fill, useTranslations } from "../../utils/i18n";
import { breadcrumbJsonLd } from "../../utils/seo";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const mailto = `mailto:${site.email}`;

const jsonLd = [
  breadcrumbJsonLd([
    { label: "Home", path: `/${lang}/` },
    { label: t.contact.title, path: `/${lang}/contact/` }
  ])
];
---

<BaseLayout
  lang={lang}
  title={t.contact.title}
  description={t.contact.intro}
  canonicalPath={`/${lang}/contact/`}
  alternates={{ id: "/id/contact/", en: "/en/contact/" }}
  jsonLd={jsonLd}
>
  <header class="page-header">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label={t.common.menu}>
        <ol>
          <li><a href={`/${lang}/`}>{t.common.home}</a></li>
          <li aria-current="page">{t.contact.title}</li>
        </ol>
      </nav>
      <h1 class="page-title">{t.contact.title}</h1>
      <p class="page-lead">{t.contact.intro}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap contact-grid">
      <div>
        <div class="contact-block">
          <h2>{t.contact.emailLabel}</h2>
          <a class="contact-email" href={mailto}>{site.email}</a>
          <p class="text-muted" style="margin-top: 0.5rem;">{t.contact.responseNote}</p>
        </div>

        <div class="contact-block">
          <h2>{t.contact.socialLabel}</h2>
          <ul class="tag-list">
            {site.socials.map((social) => (
              <li>
                <a class="tag" href={social.url} target="_blank" rel="me noopener noreferrer">
                  {social.label}
                  <span class="visually-hidden">({t.common.external})</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="contact-block">
          <h2>{t.contact.availabilityLabel}</h2>
          <p class="text-muted">{site.availability[lang]}</p>
        </div>
      </div>

      <form
        class="card"
        data-contact-form
        data-email={site.email}
        data-error-message={t.contact.formError}
        novalidate
      >
        <h2 class="card-title">{t.contact.formTitle}</h2>
        <p class="card-text">{t.contact.formNote}</p>

        <div class="form-grid" style="margin-top: 1.25rem;">
          <div class="form-row">
            <div class="form-field">
              <label for="contact-name">{t.contact.formName}</label>
              <input class="input" id="contact-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="contact-email">{t.contact.formEmail}</label>
              <input class="input" id="contact-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div class="form-field">
            <label for="contact-subject">{t.contact.formSubject}</label>
            <input
              class="input"
              id="contact-subject"
              name="subject"
              type="text"
              placeholder={t.contact.subjectPlaceholder}
            />
          </div>

          <div class="form-field">
            <label for="contact-message">{t.contact.formMessage}</label>
            <textarea class="textarea" id="contact-message" name="message" rows="6" required></textarea>
          </div>

          <p class="form-error" data-form-error role="alert"></p>

          <button class="btn btn-primary" type="submit">{t.contact.formSubmit}</button>
        </div>

        <p class="eyebrow" style="margin-top: 1rem;">
          <a href={mailto}>{fill(t.contact.mailtoFallback, { email: site.email })}</a>
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const errorEl = form.querySelector<HTMLElement>("[data-form-error]");
    const errorMessage = form.dataset.errorMessage ?? "Please complete the required fields.";
    const to = form.dataset.email ?? "";

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const subject = String(data.get("subject") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();

      if (!name || !email || !message) {
        if (errorEl) errorEl.textContent = errorMessage;
        return;
      }

      if (errorEl) errorEl.textContent = "";

      const body = `${message}\n\n- ${name} (${email})`;
      const mailto = `mailto:${to}?subject=${encodeURIComponent(subject || `Website enquiry from ${name}`)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;
    });
  }
</script>
