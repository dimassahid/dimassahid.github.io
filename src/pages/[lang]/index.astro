---
import ArticleCard from "../../components/ArticleCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../data/projects";
import { expertise, languages, site, yearsOfExperience, type Lang } from "../../data/site";
import { getLatestPosts } from "../../utils/content";
import { useTranslations } from "../../utils/i18n";
import { personJsonLd, websiteJsonLd } from "../../utils/seo";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const years = yearsOfExperience();
const yearsLabel = t.common.yearsExperience.replace("{years}", String(years));
const latest = await getLatestPosts(lang, 3);
const projects = getProjects().slice(0, 3);
const bio = site.bio[lang];
const alternates = { id: "/id/", en: "/en/" } as const;
---

<BaseLayout
  lang={lang}
  description={site.description[lang]}
  canonicalPath={`/${lang}/`}
  alternates={alternates}
  jsonLd={[personJsonLd(), websiteJsonLd(lang)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="hero-title">{site.tagline[lang]}</h1>
        <p class="hero-text">{site.intro[lang]}</p>

        <div class="hero-meta">
          <span class="badge badge-accent">{site.role[lang]}</span>
          <a class="badge badge-credential" href={`/${lang}/about/#credentials`}>
            OSCP+ <span aria-hidden="true">→</span>
          </a>
          <span class="badge">{yearsLabel}</span>
          <span class="badge badge-dot">{site.availabilityShort[lang]}</span>
        </div>

        <div class="hero-actions btn-row">
          <a class="btn btn-primary" href={`/${lang}/portfolio/`}>{t.home.ctaWork}</a>
          <a class="btn" href={`/${lang}/writeups/`}>{t.home.ctaArticles}</a>
          <a class="btn btn-ghost" href={`/${lang}/contact/`}>{t.home.ctaContact}</a>
        </div>
      </div>

      <div class="terminal">
        <div class="terminal-bar">
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-title">{t.home.terminalTitle}</span>
        </div>
        <div class="terminal-body">
          <p>
            <span class="prompt">$</span> <span class="command">{t.home.terminalCommand}</span>
          </p>
          {t.home.terminalLines.map((line) => <p>{line}</p>)}
          <p>
            <span class="prompt">$</span> <span class="cursor">_</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-divider">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.home.expertiseTitle}</h2>
          <p class="section-lead">{t.home.expertiseIntro}</p>
        </div>
      </div>

      <div class="grid grid-cards">
        {expertise.map((item) => (
          <article class="card">
            <p class="eyebrow">{item.code}</p>
            <h3 class="card-title">{item.title[lang]}</h3>
            <p class="card-text">{item.description[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.home.projectsTitle}</h2>
          <p class="section-lead">{t.home.projectsIntro}</p>
        </div>
        <a class="btn btn-ghost" href={`/${lang}/portfolio/`}>{t.home.projectsLink}</a>
      </div>

      <div class="grid grid-cards">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-divider">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title">{t.home.latestTitle}</h2>
          <p class="section-lead">{t.home.latestIntro}</p>
        </div>
        <a class="btn btn-ghost" href={`/${lang}/writeups/`}>{t.home.latestLink}</a>
      </div>

      <div class="grid grid-cards">
        {latest.map((post) => (
          <ArticleCard post={post} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <h2>{t.home.aboutTitle}</h2>
        <p>{bio[0]}</p>
        <div class="btn-row">
          <a class="btn" href={`/${lang}/about/`}>{t.home.aboutLink}</a>
          <a class="btn btn-primary" href={`/${lang}/contact/`}>{t.home.contactLink}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
