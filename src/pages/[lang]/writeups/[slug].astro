---
import { render } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { languages, type Lang } from "../../../data/site";
import { getPost, getPosts } from "../../../utils/content";

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: Lang; slug: string } }> = [];
  for (const lang of languages) {
    const posts = await getPosts("writeups", lang);
    for (const post of posts) {
      paths.push({ params: { lang, slug: post.slug } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;

const detail = await getPost("writeups", lang, slug);
if (!detail) throw new Error(`Missing writeups entry for ${lang}/${slug}.`);

const { Content, headings } = await render(detail.entry);
---

<ArticleLayout post={detail.post} detail={detail} headings={headings}>
  <Content />
</ArticleLayout>
