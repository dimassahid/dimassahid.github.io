---
import ListingExplorer from "../../components/ListingExplorer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLanguage } from "../../data/site";
import { getPosts } from "../../utils/content";
import { useTranslations } from "../../utils/i18n";
import { breadcrumbJsonLd } from "../../utils/seo";

const lang = defaultLanguage;
const t = useTranslations(lang);
const posts = await getPosts("writeups", lang);

const jsonLd = [
  breadcrumbJsonLd([
    { label: "Home", path: "/" },
    { label: t.writeups.title, path: "/writeups/" }
  ])
];
---

<BaseLayout
  lang={lang}
  title={t.writeups.title}
  description={t.writeups.intro}
  canonicalPath="/writeups/"
  jsonLd={jsonLd}
>
  <header class="page-header">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label={t.common.menu}>
        <ol>
          <li><a href="/">{t.common.home}</a></li>
          <li aria-current="page">{t.writeups.title}</li>
        </ol>
      </nav>
      <h1 class="page-title">{t.writeups.title}</h1>
      <p class="page-lead">{t.writeups.intro}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <ListingExplorer lang={lang} posts={posts} indexUrl="/search-index.json" />

      <div class="notice" style="margin-top: 2rem;">
        <div>
          <strong>{t.writeups.disclosureTitle}</strong>
          <p>{t.writeups.disclosureText}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
