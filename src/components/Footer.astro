---
import type { Lang } from "../data/site";
import { navigation, site } from "../data/site";
import { useTranslations } from "../utils/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

function localized(path: string): string {
  const clean = path.replace(/^\/+/, "").replace(/\/+$/, "");
  return clean === "" ? `/${lang}/` : `/${lang}/${clean}/`;
}
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={`/${lang}/`}>
          <span class="brand-mark brand-mark-photo" aria-hidden="true">
            <img src="/images/logo-mark-sm.png" alt="" width="96" height="128" loading="lazy" decoding="async" />
          </span>
          <span class="brand-text">
            {site.name}
            <small>{site.role[lang]}</small>
          </span>
        </a>
        <p>{t.footer.tagline}</p>
      </div>

      <div>
        <h2 class="footer-heading">{t.common.menu}</h2>
        <nav aria-label={t.footer.navLabel}>
          <ul class="footer-links">
            {navigation.map((item) => (
              <li><a href={localized(item.path)}>{item.label[lang]}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <div>
        <h2 class="footer-heading">{t.contact.socialLabel}</h2>
        <ul class="footer-links">
          {site.socials.map((social) => (
            <li>
              <a href={social.url} rel="me noopener noreferrer" target="_blank">
                {social.label}
                <span class="visually-hidden">({t.common.external})</span>
              </a>
            </li>
          ))}
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {site.name}. {t.footer.rights}</p>
      <p>{t.footer.builtWith}</p>
    </div>
  </div>
</footer>
