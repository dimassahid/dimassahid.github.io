# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------
# Canonical production URL, without a trailing slash. Used for canonical tags,
# sitemap, RSS and Open Graph URLs. For a GitHub Pages user site this is
# https://<username>.github.io; for a project page add the /<repo> base too and
# set `base` in astro.config.mjs.
SITE_URL=https://your-username.github.io

# Fallback author shown on articles when a Notion page has no Author value.
SITE_AUTHOR=YOUR NAME

# ---------------------------------------------------------------------------
# Notion content source (only used by scripts/sync-notion.mjs)
# ---------------------------------------------------------------------------
# Internal integration secret. Never prefix with PUBLIC_ and never commit it.
NOTION_TOKEN=
# Database id from the Notion database URL (the 32-character id before ?v=).
NOTION_DATABASE_ID=
# Optional: newer Notion API versions query a data source instead of a database.
# When set, NOTION_API_VERSION defaults to 2025-09-03.
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=

# Defaults for pages whose Language / Section property is empty.
# Use en when the Notion pages are written in English: the sync then writes
# <slug>.en.md with lang: "en" and the site serves them under /en/.
NOTION_DEFAULT_LANGUAGE=id
NOTION_DEFAULT_SECTION=writeups
# Fallback category key (see src/data/categories.ts) for pages that have no
# Category value. Empty means "general".
# NOTION_DEFAULT_CATEGORY=lab-writeups

# Optional: comma separated Notion status values written as drafts, e.g.
# "Not started,Todo". Empty keeps the Draft checkbox as the only signal.
# NOTION_DRAFT_STATUSES=

# Optional property-name overrides if your database uses different labels.
# NOTION_PROP_TITLE=Name
# NOTION_PROP_SLUG=Slug
# NOTION_PROP_DESCRIPTION=Description
# NOTION_PROP_CATEGORY=Category
# NOTION_PROP_TAGS=Tags
# NOTION_PROP_OS=OS
# NOTION_PROP_SEVERITY=Severity
# NOTION_PROP_PUBLISHED=Published
# NOTION_PROP_UPDATED=Updated
# NOTION_PROP_DRAFT=Draft
# NOTION_PROP_FEATURED=Featured
# NOTION_PROP_LANG=Language
# NOTION_PROP_TRANSLATIONKEY=TranslationKey
# NOTION_PROP_SECTION=Section

# ---------------------------------------------------------------------------
# Translation (Azure Translator v3)
# ---------------------------------------------------------------------------
TRANSLATION_ENABLED=true
# azure | none
TRANSLATION_PROVIDER=azure

# Azure Translator resource credentials (server-side only, never PUBLIC_).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Language of your Notion pages: id | en. Set it to the same value as
# NOTION_DEFAULT_LANGUAGE (e.g. en for an English library). Anything else
# (e.g. "auto") falls back to NOTION_DEFAULT_LANGUAGE.
TRANSLATION_SOURCE_LANGUAGE=id

# Persistent cache committed to the repository so rebuilds stay deterministic.
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_DIR=src/data/translation-cache

# Guard rails for a single sync run (project limits, not the Azure quota).
TRANSLATION_MAX_CHARACTERS_PER_BUILD=100000
TRANSLATION_MAX_REQUESTS_PER_BUILD=40
# Monthly budget persisted in the cache usage file. Leave empty for unlimited.
TRANSLATION_MAX_CHARACTERS_PER_MONTH=
